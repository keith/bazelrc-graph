digraph bazelrc {
  rankdir=LR;
  fontname="Helvetica";
  node [fontname="Helvetica"];
  edge [fontname="Helvetica"];

  // Config graph
  "config: bar" [label="bar", shape=ellipse, style=dashed, color="#cc0000", fontcolor="#cc0000"];
  "config: baz" [label="baz", shape=ellipse, style=dashed, color="#cc0000", fontcolor="#cc0000"];
  "config: foo" [label="foo", shape=ellipse];
  "config: foo" -> "config: bar";
  "config: foo" -> "config: baz";

  // File import graph
  subgraph cluster_imports {
    label="file imports";
    fontsize=10;
    style="rounded,dashed";
    color="#999999";
    node [shape=note, fontsize=10];
    "file: .bazelrc" [label=".bazelrc"];
    "file: shared.bazelrc" [label="shared.bazelrc"];
    "file: .bazelrc" -> "file: shared.bazelrc";
  }
}
