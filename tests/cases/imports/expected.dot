digraph bazelrc {
  rankdir=LR;
  fontname="Helvetica";
  node [fontname="Helvetica"];
  edge [fontname="Helvetica"];

  // Config graph
  "config: <default>" [label="default", shape=box];
  "config: ci" [label="ci", shape=ellipse];
  "config: defaults" [label="defaults", shape=ellipse];
  "config: remote" [label="remote", shape=ellipse];
  "config: <default>" -> "config: defaults";
  "config: ci" -> "config: remote";

  // File import graph
  subgraph cluster_imports {
    label="file imports";
    fontsize=10;
    style="rounded,dashed";
    color="#999999";
    node [shape=note, fontsize=10];
    "file: .bazelrc" [label=".bazelrc"];
    "file: shared.bazelrc" [label="shared.bazelrc"];
    "file: user.bazelrc" [label="user.bazelrc", style=dashed, color="#999999", fontcolor="#999999"];
    "file: .bazelrc" -> "file: shared.bazelrc";
    "file: .bazelrc" -> "file: user.bazelrc" [style=dotted];
  }
}
